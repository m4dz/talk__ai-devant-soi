# Machine de génération sur le réseau local (jalons 3-4).
# IP fixe recommandée le jour J (mDNS .local fragile en salle de conf).
VITE_GEN_HOST=http://192.168.1.50:8000

# Machine hébergeant Qwen3-TTS (souvent = machine de génération).
VITE_TTS_HOST=http://192.168.1.50:8100

# 1 = mode mock : répéter sans la machine distante (fallback embarqué).
# (jalon 4 : VITE_MOCK=0 bascule vers le client réel.)
VITE_MOCK=1

# Durée du compte à rebours, en minutes. Défaut 28 — durée GRAVÉE par les
# scripts (lancement section 3 ~minute 13, zéro au début de la section 7).
# Baisser pour répéter le timing en accéléré (ex. VITE_COUNTDOWN_MINUTES=2).
VITE_COUNTDOWN_MINUTES=28
