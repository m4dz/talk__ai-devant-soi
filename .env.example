# Machine de génération sur le réseau local (jalons 3-4).
# IP fixe recommandée le jour J (mDNS .local fragile en salle de conf).
# UN SEUL HOST : le chapitre ET l'audio (voix clonée) sortent d'ici — le TTS
# tourne sur la machine de génération, pas de VITE_TTS_HOST séparé.
VITE_GEN_HOST=http://192.168.1.50:8420

# 1 = mode mock : répéter sans la machine distante (fallback embarqué). Le mock
#     REJOUE la vraie timeline du contrat back (labels, détails, phases, récit)
#     pour que la répétition montre le même écran que le jour J.
# 0 = client réel : POST /generate, sondage /status, flux d'étapes SSE
#     ${VITE_GEN_HOST}/events, fallback silencieux. À METTRE À 0 POUR LE LIVE.
# L'URL du flux se déduit de VITE_GEN_HOST — pas de variable dédiée.
VITE_MOCK=1

# Scénario rejoué par le mock (VITE_MOCK=1) : nominal | error | idle.
#   nominal = déroulé complet generating → tts → ready (défaut) ;
#   error   = échec de préflight → repli embarqué silencieux (indistinguable) ;
#   idle    = annulation opérateur ignorée → chapitre embarqué posé à zéro.
VITE_MOCK_SCENARIO=nominal

# Durée du compte à rebours, en minutes. Défaut 28 — durée GRAVÉE par les
# scripts (lancement section 3 ~minute 13, zéro au début de la section 7).
# Baisser pour répéter le timing en accéléré (ex. VITE_COUNTDOWN_MINUTES=2).
# NB : sous 3 minutes, la fenêtre de relance après échec (180 s écoulées)
# couvre tout le décompte — la relance unique se déclenche donc toujours.
VITE_COUNTDOWN_MINUTES=28
